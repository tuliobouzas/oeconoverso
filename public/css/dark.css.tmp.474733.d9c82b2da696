/* ==========================================================================
   MODO ESCURO — "Edição Noturna"
   Jornal art déco: Nova York à noite, anos 1920. Azul-petróleo + dourado.
   Estrutura de jornal preservada; só a identidade visual muda.
   ========================================================================== */

/* --- Skyline atrás do título --------------------------------------------- */
body.dark-mode .title {
    background:
        linear-gradient(to right, var(--bg-color) 0%, transparent 15%, transparent 85%, var(--bg-color) 100%),
        linear-gradient(to bottom, rgba(12, 21, 23, 0.5) 0%, rgba(12, 21, 23, 0.1) 50%, rgba(12, 21, 23, 0.75) 92%, var(--bg-color) 100%),
        url('../img/skyline-title.webp') center top / cover no-repeat;
}

/* --- Barra de data → letreiro "Edição Noturna" --------------------------- */
body.dark-mode .newspaper-date {
    font-family: var(--bebas-font);
    font-size: calc(var(--body-font-size) * 0.95);
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    padding: 2px 0;
}

body.dark-mode .newspaper-date::before {
    content: "Edição Noturna \25C6\00A0\00A0 Fechamento dos Mercados \25C6\00A0\00A0 ";
}

body.dark-mode .newspaper-line-top,
body.dark-mode .newspaper-line-bottom {
    box-shadow: 0 0 8px rgba(212, 169, 78, 0.35);
}

/* --- Molduras art déco nos boxes da primeira página ----------------------- */
body.dark-mode .manchete,
body.dark-mode .econopedia-box {
    position: relative;
    border: 1px solid var(--gold-dim);
    outline: 1px solid rgba(212, 169, 78, 0.22);
    outline-offset: 5px;
    background: linear-gradient(165deg, rgba(21, 52, 58, 0.28), rgba(8, 14, 15, 0.5));
    box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.4);
}

/* losango dourado no topo da moldura, como nos letreiros déco */
body.dark-mode .manchete::before,
body.dark-mode .econopedia-box::before {
    content: "\25C6";
    position: absolute;
    top: -0.7em;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    font-size: 14px;
    background: var(--bg-color);
    padding: 0 10px;
    text-shadow: 0 0 8px var(--amber-glow);
}

/* títulos com brilho de letreiro */
body.dark-mode .manchete h1,
body.dark-mode .econopedia-box h2,
body.dark-mode .article-title,
body.dark-mode .section-title {
    text-shadow: 0 0 16px rgba(240, 199, 94, 0.3);
}

body.dark-mode .manchete-meta {
    letter-spacing: 3px;
}

/* o degradê do resumo acompanha o fundo do box */
body.dark-mode .summary-gradient {
    background: linear-gradient(to bottom, transparent 0%, rgba(11, 19, 21, 0.92) 70%, rgba(11, 19, 21, 0.98) 100%);
}

/* --- Botões "Continuar lendo" --------------------------------------------- */
body.dark-mode .read-more-btn {
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold) !important;
    box-shadow: 0 0 12px rgba(212, 169, 78, 0.25), inset 0 0 8px rgba(212, 169, 78, 0.12);
}

body.dark-mode .read-more-btn:hover {
    background: var(--gold);
    color: var(--petrol-deep) !important;
    transform: none;
    box-shadow: 0 0 20px rgba(212, 169, 78, 0.55);
}

/* --- Barra lateral: marquee art déco -------------------------------------- */
body.dark-mode #my-links {
    background: linear-gradient(to bottom, var(--petrol) 0%, var(--petrol-deep) 100%) !important;
    border-right: 1px solid var(--gold-dim);
    box-shadow: 2px 0 24px rgba(0, 0, 0, 0.8), inset -14px 0 24px rgba(0, 0, 0, 0.35);
}

body.dark-mode .menubar-link:hover .label {
    color: var(--gold-bright);
    text-shadow: 0 0 12px var(--amber-glow);
    transition: color 0.2s, text-shadow 0.2s;
}

body.dark-mode .menubar-link.menubar-active .label {
    text-shadow: 0 0 14px var(--amber-glow);
}

/* moeda do menu com brilho quente */
body.dark-mode .menu-coin {
    filter: drop-shadow(0 0 14px rgba(212, 169, 78, 0.35));
}

/* --- Imagens de posts: tom noturno + fio dourado --------------------------- */
body.dark-mode .post-image {
    border: 1px solid var(--gold-dim);
    padding: 4px;
    filter: brightness(0.95) saturate(1.1) contrast(1.05);
    box-shadow: 0 0 16px rgba(0, 0, 0, 0.6);
}

